import Mathlib

/-!
# Chebyshev's inequality from variance shrinkage

This is an UNTESTED Lean 4 / Mathlib draft.
It does not invoke Mathlib's Chebyshev or Markov inequalities.

The main result is formulated for a positive linear expectation functional.
Such a functional includes integration against a probability measure.
The finite-weight corollary provides an explicit, executable model.
-/

namespace ChebyshevShrinkage

/-- Signed indicator of the two tails. -/
noncomputable def tailSign (y t : ℝ) : ℝ :=
  if t ≤ y then 1 else if y ≤ -t then -1 else 0

/-- Real-valued indicator of a deviation of size at least `t`. -/
noncomputable def tailIndicator (y t : ℝ) : ℝ :=
  if t ≤ |y| then 1 else 0

lemma tailSign_sq (y t : ℝ) (ht : 0 < t) :
    (tailSign y t) ^ 2 = tailIndicator y t := by
  by_cases hp : t ≤ y
  · have hy : 0 ≤ y := by linarith
    have ha : t ≤ |y| := by simpa [abs_of_nonneg hy] using hp
    simp [tailSign, tailIndicator, hp, ha]
  · by_cases hn : y ≤ -t
    · have hy : y ≤ 0 := by linarith
      have ha : t ≤ |y| := by rw [abs_of_nonpos hy]; linarith
      simp [tailSign, tailIndicator, hp, hn, ha]
    · have ha : ¬ t ≤ |y| := by
        have hlt : |y| < t := (abs_lt).2 ⟨by linarith, by linarith⟩
        exact not_le.mpr hlt
      simp [tailSign, tailIndicator, hp, hn, ha]

lemma tailSign_excess_nonneg (y t : ℝ) (_ht : 0 < t) :
    0 ≤ y * tailSign y t - t * (tailSign y t) ^ 2 := by
  by_cases hp : t ≤ y
  · simp [tailSign, hp]
  · by_cases hn : y ≤ -t
    · have h : 0 ≤ -y - t := by linarith
      simpa [tailSign, hp, hn] using h
    · simp [tailSign, hp, hn]

/-- An abstract expectation is positive if it maps nonnegative functions
    to nonnegative numbers. -/
def IsPositiveExpectation {Ω : Type*}
    (E : (Ω → ℝ) →ₗ[ℝ] ℝ) : Prop :=
  ∀ f : Ω → ℝ, (∀ ω, 0 ≤ f ω) → 0 ≤ E f

/-- Pointwise square identity underlying threshold shrinkage. -/
lemma shrinkage_square_identity (y s t : ℝ) :
    y ^ 2 = (y - t * s) ^ 2 + t ^ 2 * s ^ 2 +
      2 * t * (y * s - t * s ^ 2) := by
  ring

/-- Chebyshev's inequality in the positive-linear-expectation model.
    No use of Markov's inequality or Mathlib's Chebyshev theorem. -/
theorem chebyshev_from_shrinkage {Ω : Type*}
    (E : (Ω → ℝ) →ₗ[ℝ] ℝ)
    (hE : IsPositiveExpectation E)
    (Y : Ω → ℝ) (t : ℝ) (ht : 0 < t) :
    t ^ 2 * E (fun ω => tailIndicator (Y ω) t) ≤
      E (fun ω => (Y ω) ^ 2) := by
  let S : Ω → ℝ := fun ω => tailSign (Y ω) t
  have hS : (fun ω : Ω => (S ω) ^ 2) =
      (fun ω : Ω => tailIndicator (Y ω) t) := by
    funext ω
    exact tailSign_sq (Y ω) t ht
  have hres : 0 ≤ E (fun ω => (Y ω - t * S ω) ^ 2) :=
    hE _ (fun ω => sq_nonneg _)
  have hexcess : 0 ≤ E (fun ω => Y ω * S ω - t * (S ω) ^ 2) :=
    hE _ (fun ω => tailSign_excess_nonneg (Y ω) t ht)
  have hfun : (fun ω : Ω => (Y ω) ^ 2) =
      (fun ω : Ω => (Y ω - t * S ω) ^ 2) +
      (t ^ 2) • (fun ω : Ω => (S ω) ^ 2) +
      (2 * t) • (fun ω : Ω => Y ω * S ω - t * (S ω) ^ 2) := by
    funext ω
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    ring
  have hidentity : E (fun ω => (Y ω) ^ 2) =
      E (fun ω => (Y ω - t * S ω) ^ 2) +
      t ^ 2 * E (fun ω => (S ω) ^ 2) +
      (2 * t) * E (fun ω => Y ω * S ω - t * (S ω) ^ 2) := by
    rw [hfun]
    simp only [map_add, map_smul, smul_eq_mul]
  rw [← hS]
  rw [hidentity]
  have ht2 : 0 ≤ 2 * t := by linarith
  have hterm : 0 ≤ (2 * t) *
      E (fun ω => Y ω * S ω - t * (S ω) ^ 2) :=
    mul_nonneg ht2 hexcess
  linarith

/-- Exact variance-shrinkage decomposition for any centered variable Y
    and any auxiliary function S. -/
theorem variance_shrinkage_identity {Ω : Type*}
    (E : (Ω → ℝ) →ₗ[ℝ] ℝ)
    (hOne : E (fun _ : Ω => (1 : ℝ)) = 1)
    (Y S : Ω → ℝ) (hcenter : E Y = 0) (t : ℝ) :
    E (fun ω => (Y ω) ^ 2) =
      E (fun ω => (Y ω - t * S ω + t * E S) ^ 2) +
      t ^ 2 * E (fun ω => (S ω) ^ 2) +
      t ^ 2 * (E S) ^ 2 +
      2 * t * E (fun ω => Y ω * S ω - t * (S ω) ^ 2) := by
  let W : Ω → ℝ := fun ω => Y ω - t * S ω
  let d : ℝ := E S
  have hW : W = Y - t • S := by
    funext ω
    simp [W, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  have hWmean : E W = -t * d := by
    rw [hW]
    simp only [map_sub, map_smul, smul_eq_mul, hcenter]
    dsimp [d]
    ring
  have hshiftfun : (fun ω : Ω => (W ω + t * d) ^ 2) =
      (fun ω : Ω => (W ω) ^ 2) +
      (2 * t * d) • W +
      (t ^ 2 * d ^ 2) • (fun _ : Ω => (1 : ℝ)) := by
    funext ω
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    ring
  have hshift : E (fun ω => (W ω + t * d) ^ 2) =
      E (fun ω => (W ω) ^ 2) - t ^ 2 * d ^ 2 := by
    rw [hshiftfun]
    simp only [map_add, map_smul, smul_eq_mul, hWmean, hOne]
    ring
  have hfun : (fun ω : Ω => (Y ω) ^ 2) =
      (fun ω : Ω => (W ω) ^ 2) +
      (t ^ 2) • (fun ω : Ω => (S ω) ^ 2) +
      (2 * t) • (fun ω : Ω => Y ω * S ω - t * (S ω) ^ 2) := by
    funext ω
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    dsimp [W]
    ring
  have henergy : E (fun ω => (Y ω) ^ 2) =
      E (fun ω => (W ω) ^ 2) +
      t ^ 2 * E (fun ω => (S ω) ^ 2) +
      (2 * t) * E (fun ω => Y ω * S ω - t * (S ω) ^ 2) := by
    rw [hfun]
    simp only [map_add, map_smul, smul_eq_mul]
  calc
    E (fun ω => (Y ω) ^ 2) =
        E (fun ω => (W ω) ^ 2) +
        t ^ 2 * E (fun ω => (S ω) ^ 2) +
        (2 * t) * E (fun ω => Y ω * S ω - t * (S ω) ^ 2) := henergy
    _ = E (fun ω => (W ω + t * d) ^ 2) +
        t ^ 2 * E (fun ω => (S ω) ^ 2) +
        t ^ 2 * d ^ 2 +
        2 * t * E (fun ω => Y ω * S ω - t * (S ω) ^ 2) := by
          rw [hshift]
          ring
    _ = _ := by rfl

/-- Stronger Chebyshev inequality, incorporating the imbalance between
    the upper and lower tails. -/
theorem chebyshev_with_tail_imbalance {Ω : Type*}
    (E : (Ω → ℝ) →ₗ[ℝ] ℝ)
    (hE : IsPositiveExpectation E)
    (hOne : E (fun _ : Ω => (1 : ℝ)) = 1)
    (Y : Ω → ℝ) (hcenter : E Y = 0)
    (t : ℝ) (ht : 0 < t) :
    t ^ 2 * (E (fun ω => tailIndicator (Y ω) t) +
      (E (fun ω => tailSign (Y ω) t)) ^ 2) ≤
      E (fun ω => (Y ω) ^ 2) := by
  let S : Ω → ℝ := fun ω => tailSign (Y ω) t
  have hS : (fun ω : Ω => (S ω) ^ 2) =
      (fun ω : Ω => tailIndicator (Y ω) t) := by
    funext ω
    exact tailSign_sq (Y ω) t ht
  have hres : 0 ≤ E (fun ω => (Y ω - t * S ω + t * E S) ^ 2) :=
    hE _ (fun ω => sq_nonneg _)
  have hexcess : 0 ≤ E (fun ω => Y ω * S ω - t * (S ω) ^ 2) :=
    hE _ (fun ω => tailSign_excess_nonneg (Y ω) t ht)
  have hidentity := variance_shrinkage_identity E hOne Y S hcenter t
  rw [hS] at hidentity
  have ht2 : 0 ≤ 2 * t := by linarith
  have hterm : 0 ≤ (2 * t) *
      E (fun ω => Y ω * S ω - t * (S ω) ^ 2) :=
    mul_nonneg ht2 hexcess
  change t ^ 2 * (E (fun ω => tailIndicator (Y ω) t) + (E S) ^ 2) ≤
    E (fun ω => (Y ω) ^ 2)
  rw [hidentity]
  nlinarith

/-- A concrete weighted expectation over a finite sample space. -/
def finiteExpectation {Ω : Type*} [Fintype Ω]
    (w : Ω → ℝ) : (Ω → ℝ) →ₗ[ℝ] ℝ where
  toFun := fun f => ∑ ω, w ω * f ω
  map_add' := by
    intro f g
    change (∑ ω, w ω * (f ω + g ω)) =
      (∑ ω, w ω * f ω) + (∑ ω, w ω * g ω)
    simp [mul_add, Finset.sum_add_distrib]
  map_smul' := by
    intro a f
    change (∑ ω, w ω * (a * f ω)) = a * (∑ ω, w ω * f ω)
    calc
      (∑ ω, w ω * (a * f ω)) = ∑ ω, a * (w ω * f ω) := by
        apply Finset.sum_congr rfl
        intro ω _
        ring
      _ = a * ∑ ω, w ω * f ω := by rw [Finset.mul_sum]

@[simp] lemma finiteExpectation_apply {Ω : Type*} [Fintype Ω]
    (w f : Ω → ℝ) :
    finiteExpectation w f = ∑ ω, w ω * f ω := rfl

lemma finiteExpectation_positive {Ω : Type*} [Fintype Ω]
    (w : Ω → ℝ) (hw : ∀ ω, 0 ≤ w ω) :
    IsPositiveExpectation (finiteExpectation w) := by
  intro f hf
  change 0 ≤ ∑ ω, w ω * f ω
  exact Finset.sum_nonneg (fun ω _ => mul_nonneg (hw ω) (hf ω))

/-- Concrete finite-distribution version; the weights are nonnegative.
    When they sum to one, the left-hand sum is t^2 times tail probability. -/
theorem finite_chebyshev {Ω : Type*} [Fintype Ω]
    (w : Ω → ℝ) (hw : ∀ ω, 0 ≤ w ω)
    (Y : Ω → ℝ) (t : ℝ) (ht : 0 < t) :
    t ^ 2 * (∑ ω, w ω * tailIndicator (Y ω) t) ≤
      ∑ ω, w ω * (Y ω) ^ 2 := by
  simpa only [finiteExpectation_apply] using
    chebyshev_from_shrinkage (finiteExpectation w)
      (finiteExpectation_positive w hw) Y t ht


/-- Standard Chebyshev form on a finite probability space. The weights
    are nonnegative and normalized, and the center is the weighted mean. -/
theorem finite_chebyshev_about_mean {Ω : Type*} [Fintype Ω]
    (w : Ω → ℝ) (hw : ∀ ω, 0 ≤ w ω)
    (_hprob : (∑ ω, w ω) = 1)
    (X : Ω → ℝ) (t : ℝ) (ht : 0 < t) :
    t ^ 2 * (∑ ω, w ω * tailIndicator
      (X ω - ∑ ν, w ν * X ν) t) ≤
      ∑ ω, w ω * (X ω - ∑ ν, w ν * X ν) ^ 2 := by
  exact finite_chebyshev w hw
    (fun ω => X ω - ∑ ν, w ν * X ν) t ht

